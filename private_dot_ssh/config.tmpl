{{- if eq .distro "macos" }}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
Include ~/.orbstack/ssh/config

{{ end -}}
# Machine-local entries we deliberately do not version. Keep this above the
# Host blocks: ssh takes the first value it sees for each keyword.
Include ~/.ssh/config.local

Host rsync
    HostName usw-s007.rsync.net
    User 57127

{{- if eq .distro "macos" }}

# Load keys into the agent on first use, with the passphrase from the macOS
# Keychain. Then no ssh-add is necessary after a reboot. UseKeychain is only
# in Apple's OpenSSH build. Keep this block last: ssh takes the first value it
# sees for each keyword, so the specific Host blocks above win.
Host *
    AddKeysToAgent yes
    UseKeychain yes
{{- end }}
