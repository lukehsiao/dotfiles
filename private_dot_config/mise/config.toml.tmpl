# Dev tools that ship prebuilt binaries and release faster than distro
# packaging. Omarchy's own split is a pacman base plus mise for runtimes and
# vendor CLIs, so anything the desktop or another package depends on stays in
# pacman/brew. Shims are appended to PATH, not prepended, so a leftover system
# copy would shadow the mise one. A tool whose distro package shipped shell
# completions also needs a regenerating stub in fish/completions.
#
# Tools carrying an `os` restriction publish no linux/arm64 release assets.
# The restriction makes mise skip them on that platform instead of failing
# the whole `mise install`, which matters in devcontainers on Apple Silicon.
[tools]
atuin = "latest"
bottom = "latest"
choose = "latest"
croc = "latest"
d2 = "latest"
delta = "latest"
difftastic = "latest"
dprint = "latest"
duf = "latest"
"github:bensadeh/tailspin" = "latest"
"github:blopker/codebook" = "latest"
"github:bram209/leptosfmt" = { version = "latest", os = ["macos", "linux/x64"] }
"github:EmbarkStudios/cargo-deny" = "latest"
"github:github/git-sizer" = "latest"
"github:ifd3f/caligula" = "latest"
"github:latex-lsp/texlab" = "latest"
"github:leptos-rs/cargo-leptos" = "latest"
"github:ltex-plus/ltex-ls-plus" = "latest"
"github:lukehsiao/git-stats" = "latest"
"github:lukehsiao/openring-rs" = "latest"
"github:mfontanini/presenterm" = "latest"
"github:mstange/samply" = "latest"
"github:nextest-rs/nextest" = "latest"
"github:o2sh/onefetch" = "latest"
"github:obi1kenobi/cargo-semver-checks" = "latest"
"github:pagefind/pagefind" = "latest"
"github:pamburus/hl" = "latest"
"github:pdfcpu/pdfcpu" = "latest"
"github:RazrFalcon/svgcleaner" = { version = "latest", os = ["macos", "linux/x64"] }
"github:rustwasm/wasm-bindgen" = "latest"
"github:sharkdp/pastel" = "latest"
"github:taiki-e/cargo-llvm-cov" = "latest"
"github:tectonic-typesetting/tectonic" = "latest"
"github:tekumara/typos-lsp" = "latest"
"github:tummychow/git-absorb" = "latest"
"github:vale-cli/vale-ls" = "latest"
"github:wezm/git-grab" = { version = "latest", os = ["macos", "linux/x64"] }
glow = "latest"
gping = "latest"
helm = "latest"
hexyl = "latest"
hyperfine = "latest"
jaq = "latest"
jj = "latest"
jless = { version = "latest", os = ["macos", "linux/x64"] }
k9s = "latest"
kubectl = "latest"
lychee = "latest"
marksman = "latest"
oha = "latest"
oxipng = "latest"
pandoc = "latest"
ruff = "latest"
sd = "latest"
shellcheck = "latest"
shfmt = "latest"
tealdeer = "latest"
