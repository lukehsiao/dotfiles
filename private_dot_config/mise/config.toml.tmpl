xh = "latest"
zizmor = "latest"
zola = "latest"

# mise keeps the coding agents current through `auto_update`. They release
# about once a day, and a new model can need a new client. mise's default
# 24h `minimum_release_age` hides each release for a day, so the agents set
# it to 0s. Omarchy 4.5 declares these tools with the same policy in
# /etc/mise/conf.d/omarchy-tools.toml, so they render only where that file
# is absent. An entry here would outrank that declaration and drop its lazy
# install.
{{- if not (stat "/etc/mise/conf.d/omarchy-tools.toml") }}
claude = { version = "latest", auto_update = "4h", minimum_release_age = "0s" }
codex = { version = "latest", auto_update = "4h", minimum_release_age = "0s" }
gh = "latest"
"github:can1357/oh-my-pi" = { version = "latest", auto_update = "4h", minimum_release_age = "0s" }
hunk = "latest"
{{- end }}

[settings.github]
credential_command = "head -n 1 ~/.github_token"
