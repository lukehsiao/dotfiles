-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

{{ if eq .dpi "retina" -}}
-- Optimized for retina-class 2x displays, like 13" 2.8K, 27" 5K, 32" 6K.
local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"
{{- else if eq .dpi "mid" }}
-- Good compromise for 27" or 32" 4K monitors (but fractional!)
local omarchy_gdk_scale = 1.75
local omarchy_monitor_scale = 1.666667
{{- else }}
-- Straight 1x setup for low-resolution displays like 1080p or 1440p.
local omarchy_gdk_scale = 1
local omarchy_monitor_scale = 1
{{- end }}

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- The EDID reports a 630-nit peak, which Hyprland passes on to clients even
-- in SDR. Chromium reads that as HDR headroom and tags its windows as PQ, and
-- after any config reload Hyprland renders those windows at about half
-- brightness. Capping the peak at 80 nits (the SDR white level Hyprland
-- advertises) keeps Chromium on plain gamma 2.2.
hl.monitor({
  output = "desc:ASUSTek COMPUTER INC PA32QCV",
  mode = "preferred",
  position = "auto",
  scale = 2,
  bitdepth = 10,
  cm = "dp3",
  sdr_eotf = "gamma22",
  max_luminance = 80,
  max_avg_luminance = 80,
})

-- Chromium advertises HDR-capable surfaces, so auto-HDR flips the PA32QCV
-- into HDR on every fullscreen, and the monitor blanks for ~5s to resync.
hl.config({ render = { cm_auto_hdr = 0 } })

