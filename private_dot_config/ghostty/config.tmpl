{{- if eq .distro "omarchy" -}}
# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
{{- else -}}
theme = Catppuccin Mocha
{{- end }}

# Command
{{- if eq .distro "omarchy" }}
command = /usr/bin/fish --login --interactive
{{- else }}
command = /opt/homebrew/bin/fish --login --interactive
{{- end }}

# Font
font-family = "Berkeley Mono Variable"
#  60: UltraCondensed
#  70: ExtraCondensed
#  80: Condensed
#  90: SemiCondensed
# 100: Normal
font-variation = wdth=90
font-variation = wght=400
# otfinfo -f ~/.local/share/fonts/Berkeley\ Mono\ Variable.otf
# aalt    Access All Alternates
# calt    Contextual Alternates
# ccmp    Glyph Composition/Decomposition
# mark    Mark Positioning
# mkmk    Mark to Mark Positioning
# salt    Stylistic Alternates
# ss01    Stylistic Set 1 <- slashed 0
# ss02    Stylistic Set 2 <- dotted 0
# ss03    Stylistic Set 3 <- gap 0
# ss04    Stylistic Set 4 <- slashed 0, slash 7
# ss05    Stylistic Set 5 <- dotted 0, slash 7
# ss06    Stylistic Set 6 <- gap 0, slash 7
font-feature = +calt
font-feature = +ss02
font-size = {{ if eq .distro "omarchy" }}12{{ else }}18{{ end }}
adjust-cell-height = -2%

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Ghostty fullscreens on Ctrl+Enter by default, shadowing the standard
# Omarchy fullscreen toggle. Upstream declined to unbind it themselves.
# Ref: https://github.com/basecamp/omarchy/pull/2432
keybind = control+enter=unbind

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so
# tmux and herdr can tell the two apart for their side-by-side split bindings.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
# Ghostty follows fixterms and encodes Ctrl+[ as CSI 91;5u, which helix ignores.
# Send Esc as CSI 27;1u instead of a bare 0x1b. A lone 0x1b makes multiplexers
# wait to see whether a longer sequence follows, 150ms in herdr whenever mouse
# capture is on, and a complete CSI-u sequence skips that wait. tmux needs the
# explicit ;1 because it parses extended keys as "number;modifiers".
keybind = ctrl+left_bracket=csi:27;1u
# Send Alt+Backspace as ESC+DEL for OMP
keybind = alt+backspace=text:\x1b\x7f
{{- if eq .chezmoi.os "linux" }}

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Use single instance mode for performance
gtk-single-instance=true
quit-after-last-window-closed=false
{{- end }}

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# cursor warp
custom-shader = ./shaders/cursor_warp.glsl
# custom-shader = ./shaders/tft.glsl
# custom-shader = ./shaders/crt.glsl
